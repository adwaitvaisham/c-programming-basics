#include <stdio.h>

struct Device {
    int id;
    char type[20];
    float vf;
    float ir;
    float vr;
};

int main() {
    struct Device d[100];
    int n, i;
    float max_vf, max_ir, max_vr;

    printf("Enter number of semiconductor devices: ");
    scanf("%d", &n);

    printf("Enter permissible limits (Max VF, Max IR, Max VR): ");
    scanf("%f %f %f", &max_vf, &max_ir, &max_vr);

    // Input device details
    for (i = 0; i < n; i++) {
        printf("\nEnter details for Device %d:\n", i + 1);
        printf("Device ID: ");
        scanf("%d", &d[i].id);
        printf("Device Type (Diode/BJT/MOSFET/LED): ");
        scanf("%s", d[i].type);
        printf("Forward Voltage (VF): ");
        scanf("%f", &d[i].vf);
        printf("Reverse Leakage Current (IR): ");
        scanf("%f", &d[i].ir);
        printf("Rated Voltage (VR): ");
        scanf("%f", &d[i].vr);
    }

    // Check specifications
    printf("\n--- Device Specification Report ---\n");
    for (i = 0; i < n; i++) {
        if (d[i].vf <= max_vf && d[i].ir <= max_ir && d[i].vr <= max_vr) {
            printf("ID: %d (%s) -> Within Specification\n", d[i].id, d[i].type);
        } else {
            printf("ID: %d (%s) -> OUT OF SPECIFICATION\n", d[i].id, d[i].type);
        }
    }

    return 0;
}
