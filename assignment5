#include <stdio.h>
#include <string.h>
#include <stdlib.h>

// Helper function to read strings with spaces safely and remove the trailing newline
void readString(char *str, int size) {
    fgets(str, size, stdin);
    str[strcspn(str, "\n")] = '\0';
}

int main() {
    char str1[100], str2[100], ch;
    char *ptr;
    int choice, n, result;

    do {
        printf("\n========================================\n");
        printf("      STRING OPERATIONS MENU (<string.h>)\n");
        printf("========================================\n");
        printf("1. String Length (strlen)\n");
        printf("2. String Copy (strcpy)\n");
        printf("3. String Concatenation (strcat)\n");
        printf("4. String Comparison (strcmp)\n");
        printf("5. Copy First N Characters (strncpy)\n");
        printf("6. Concatenate First N Characters (strncat)\n");
        printf("7. Find First Occurrence of Character (strchr)\n");
        printf("8. Find Substring (strstr)\n");
        printf("9. Exit\n");
        printf("----------------------------------------\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);
        
        // Clear the input buffer (newline left by scanf)
        while (getchar() != '\n');

        switch (choice) {
            case 1:
                printf("Enter a string: ");
                readString(str1, sizeof(str1));
                printf("Length of the string = %zu\n", strlen(str1));
                break;

            case 2:
                printf("Enter source string: ");
                readString(str1, sizeof(str1));
                strcpy(str2, str1);
                printf("Copied string (str2) = %s\n", str2);
                break;

            case 3:
                printf("Enter first string: ");
                readString(str1, sizeof(str1));
                printf("Enter second string: ");
                readString(str2, sizeof(str2));
                strcat(str1, str2);
                printf("Concatenated string = %s\n", str1);
                break;

            case 4:
                printf("Enter first string: ");
                readString(str1, sizeof(str1));
                printf("Enter second string: ");
                readString(str2, sizeof(str2));
                result = strcmp(str1, str2);
                if (result == 0) {
                    printf("Both strings are equal.\n");
                } else if (result > 0) {
                    printf("\"%s\" is greater than \"%s\".\n", str1, str2);
                } else {
                    printf("\"%s\" is smaller than \"%s\".\n", str1, str2);
                }
                break;

            case 5:
                printf("Enter source string: ");
                readString(str1, sizeof(str1));
                printf("Enter number of characters to copy (n): ");
                scanf("%d", &n);
                while (getchar() != '\n');
                strncpy(str2, str1, n);
                str2[n] = '\0'; // Manually add null terminator for safety
                printf("Copied string (first %d chars) = %s\n", n, str2);
                break;

            case 6:
                printf("Enter first string: ");
                readString(str1, sizeof(str1));
                printf("Enter second string: ");
                readString(str2, sizeof(str2));
                printf("Enter number of characters to append (n): ");
                scanf("%d", &n);
                while (getchar() != '\n');
                strncat(str1, str2, n);
                printf("Resulting string = %s\n", str1);
                break;

            case 7:
                printf("Enter a string: ");
                readString(str1, sizeof(str1));
                printf("Enter character to search: ");
                scanf("%c", &ch);
                while (getchar() != '\n');
                ptr = strchr(str1, ch);
                if (ptr != NULL) {
                    printf("Character '%c' found at index %ld.\n", ch, ptr - str1);
                } else {
                    printf("Character '%c' not found.\n", ch);
                }
                break;

            case 8:
                printf("Enter main string: ");
                readString(str1, sizeof(str1));
                printf("Enter substring to search: ");
                readString(str2, sizeof(str2));
                ptr = strstr(str1, str2);
                if (ptr != NULL) {
                    printf("Substring \"%s\" found at index %ld.\n", str2, ptr - str1);
                } else {
                    printf("Substring \"%s\" not found.\n", str2);
                }
                break;

            case 9:
                printf("Exiting program. Goodbye!\n");
                exit(0);

            default:
                printf("Invalid choice! Please enter a number between 1 and 9.\n");
        }
    } while (choice != 9);

    return 0;
}
